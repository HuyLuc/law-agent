GEMINI_API_KEY=
# Tuy chon: nhieu key Gemini cach nhau boi dau phay, xoay vong khi 1 key het
# quota (free tier chi ~20 request/ngay). Neu de trong, chi dung GEMINI_API_KEY.
GEMINI_API_KEYS=
GROQ_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=labor_law
LLM_MODEL=gemini-3.8-flash
# flagembedding | onnx_fp32 (mac dinh, nhanh gap doi, can `python -m
# scripts.export_onnx_reranker` truoc) | onnx_int8 (nhanh nhat, MRR@5 giam nhe)
RERANKER_BACKEND=onnx_fp32
